{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phone Deck Display",
  "version": "0.3.1",
  "identifier": "com.phonedeck.display",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Phone Deck Display",
        "width": 780,
        "height": 360,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 23,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
